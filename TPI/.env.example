# --- Base de datos ---
# Sin DATABASE_URL se usa SQLite local (tpi_inmobiliaria.db).
# Para PostgreSQL: DATABASE_URL=postgresql://usuario:clave@localhost:5432/tpi_inmobiliaria
DATABASE_URL=

# --- Flask ---
# Generar una clave propia: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
PORT=5000

# --- Datos de la cuenta recaudadora (boletas y mails) ---
BANCO_NOMBRE=Banco Santander Río
BANCO_TITULAR=InmoGestión S.A.
BANCO_CUIT=30-71889900-4
BANCO_CBU=0720123420000000456789
BANCO_ALIAS=INMO.GESTION.PAGOS
INMOBILIARIA_DOMICILIO=Av. Pellegrini 250, Rosario

# --- Servidor de correo (notificaciones automáticas) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notificaciones@inmogestion.com
MAIL_PASSWORD=your_app_password_or_token_here
MAIL_DEFAULT_SENDER=InmoGestión B2B <notificaciones@inmogestion.com>
# True = simula el envío (solo log). Poner False para enviar correos reales.
MAIL_SUPPRESS_SEND=True
