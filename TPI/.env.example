# Configuración de Base de Datos (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Configuración de Flask
FLASK_SECRET_KEY=your_super_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# Configuración de Servidor de Correo (SMTP / Notificaciones Automatizadas)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notificaciones@inmogestion.com
MAIL_PASSWORD=your_app_password_or_token_here
MAIL_DEFAULT_SENDER=InmoGestión B2B <notificaciones@inmogestion.com>
MAIL_SUPPRESS_SEND=True
